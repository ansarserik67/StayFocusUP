# ---------------------------------------------------------------------------
# Supabase (optional, but required for real Google sign-in and cloud sync)
# Create a project at https://supabase.com, then copy these from
# Project Settings → API.  The anon key is public by design; RLS protects data.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical URL, used for OAuth redirects and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
